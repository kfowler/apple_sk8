  "scripts": [
    {
      "objectId": "button1",
      "handlerName": "click",
      "source": "function(x, y) { this.set('text', 'Clicked!'); setTimeout(() => this.set('text', 'Execute Action'), 1000); }",
      "parameters": ["x", "y"]
    },
    {
      "objectId": "slider1",
      "handlerName": "change",
      "source": "function(value) { const opacity = value / 100; console.log('Opacity set to:', opacity); }",
      "parameters": ["value"]
    },
    {
      "objectId": "checkbox1",
      "handlerName": "change",
      "source": "function(checked) { console.log('Feature', checked ? 'enabled' : 'disabled'); }",
      "parameters": ["checked"]
    }
  ]
}
